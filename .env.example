# Produto (apps/web + packages/db) — copiar para .env e preencher.
# Não confundir com infra/evolution/.env.example ou infra/stack/.env.example
# (operação da agência).

# Postgres local (docker-compose.yml na raiz) ou gerenciado (Neon/Supabase).
DATABASE_URL=postgres://blademidia:blademidia_dev@localhost:5432/blademidia

# Segredo de assinatura da sessão de login (auth mínima, Fase 1).
# Gerar com: openssl rand -hex 32
SESSION_SECRET=

# --- Fase 2 (agendamento) ---

# Fuso da barbearia usado no cálculo/exibição de horários (padrão do negócio: Brasília/DF).
TZ=America/Sao_Paulo

# Worker (apps/worker + pg-boss): intervalo, em minutos, da varredura de faltas (no-show).
NO_SHOW_SWEEP_INTERVAL_MIN=5

# IA do produto (packages/ai) — ADR-0005. NÃO é usada em runtime na Fase 2 (bot é Fase 5);
# fica aqui só para a estrutura ficar pronta. Deixe em branco por enquanto.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5
