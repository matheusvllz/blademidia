# Produto (apps/web + packages/db) — copiar para .env e preencher.
# Não confundir com infra/evolution/.env.example ou infra/stack/.env.example
# (operação da agência).

# Postgres local (docker-compose.yml na raiz) ou gerenciado (Neon/Supabase).
DATABASE_URL=postgres://blademidia:blademidia_dev@localhost:5432/blademidia

# Segredo de assinatura da sessão de login (auth mínima, Fase 1).
# Gerar com: openssl rand -hex 32
SESSION_SECRET=

# --- Fase 2 (agendamento) ---

# Fuso da barbearia usado no cálculo/exibição de horários (padrão do negócio: Brasília/DF).
TZ=America/Sao_Paulo

# Worker (apps/worker + pg-boss): intervalo, em minutos, da varredura de faltas (no-show).
NO_SHOW_SWEEP_INTERVAL_MIN=5

# IA do produto (packages/ai) — ADR-0005. NÃO é usada em runtime na Fase 2 (bot é Fase 5);
# fica aqui só para a estrutura ficar pronta. Deixe em branco por enquanto.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5

# --- Fase 5 (whatsapp-canal, ADR-0004/ADR-0011) ---
# packages/whatsapp resolve para o adapter dry-run (loga em vez de enviar) se qualquer uma
# destas 4 faltar — é o modo padrão até o BSP ser contratado (ver docs/sdd/
# 06-plano-execucao-fase-5.md § 5.9/5.10). Nomes genéricos: o BSP escolhido pode expor
# credenciais com nomes ligeiramente diferentes — o formato abaixo segue a Meta Cloud API
# como referência (design.md da change add-whatsapp-canal, Decision 1).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# URL base incluindo a versão da API (ex.: https://graph.facebook.com/v21.0) — NÃO deixe uma
# versão chutada aqui; confirme a versão corrente na documentação oficial da Meta ou do BSP
# escolhido antes de preencher (plano de execução § 4.4: "não chute a versão").
WHATSAPP_API_BASE_URL=
