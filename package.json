{
  "name": "blademidia-produto",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @blademidia/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @blademidia/db generate",
    "db:migrate": "pnpm --filter @blademidia/db migrate",
    "db:migrate-automation": "pnpm --filter @blademidia/db migrate-automation",
    "db:create-barbershop": "pnpm --filter @blademidia/db create-barbershop"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  }
}
