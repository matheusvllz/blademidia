# Senha do Postgres interno do Evolution API (não é o Postgres do painel)
EVOLUTION_DB_PASSWORD=

# Chave global da API do Evolution — protege TODAS as rotas de gerenciamento de instance.
# Gerar com: openssl rand -hex 32
EVOLUTION_GLOBAL_API_KEY=

# URL pública do endpoint que recebe os webhooks (apps/web em Netlify/Vercel)
# Ex.: https://painel.blademidia.com.br/api/webhooks/evolution
EVOLUTION_WEBHOOK_URL=
